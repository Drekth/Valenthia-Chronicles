    - rid: 1575893249984299332
      type: {class: LineNode, ns: , asm: Assembly-CSharp}
      data:
        NodeGuid: accept
        NodePosition: {x: 900, y: 100}
        NextNodeGuid: end
        SpeakerName: Doyenne Maelis
        LineText: "Que les anciens veillent sur toi. Abats d'abord ses hommes, puis
          le Balafr\xE9 lui-m\xEAme."
    - rid: 1575893249984299333
      type: {class: LineNode, ns: , asm: Assembly-CSharp}
      data:
        NodeGuid: decline
        NodePosition: {x: 900, y: 300}
        NextNodeGuid: end
        SpeakerName: Doyenne Maelis
        LineText: Je comprends ta prudence. Mon offre tiendra.
    - rid: 1575893249984299334
      type: {class: LineNode, ns: , asm: Assembly-CSharp}
      data:
        NodeGuid: done
        NodePosition: {x: 600, y: -150}
        NextNodeGuid: end
        SpeakerName: Doyenne Maelis
        LineText: "Rurik est tomb\xE9... Tu as rendu l'espoir \xE0 notre hameau.
          Sois b\xE9ni, h\xE9ros."
