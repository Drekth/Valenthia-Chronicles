/* Valenthia — Quest journal (master-detail) — UI Toolkit */

.questlog__body {
    flex-direction: row;
    height: 100%;
}

/* ---- Master: quest list ---- */

.questlog__list {
    width: 220px;
    flex-shrink: 0;
    margin-right: 10px;
    padding-right: 10px;
    border-right-width: 1px;
    border-right-color: rgb(78, 62, 34);
}

.questlog__entry {
    margin-top: 0;
    margin-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 13px;
    color: rgb(232, 220, 181);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 2px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(0, 0, 0, 0);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.questlog__entry:hover {
    background-color: rgb(38, 32, 24);
}

.questlog__entry--selected {
    background-color: rgb(54, 45, 33);
    border-left-color: rgb(220, 184, 70);
}

.questlog__entry--ready {
    color: rgb(120, 200, 120);
}

/* ---- Detail pane ---- */

.questlog__detail {
    flex-grow: 1;
}

.questlog__detail-title {
    font-size: 18px;
    color: rgb(220, 184, 70);
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.questlog__detail-status {
    font-size: 13px;
    color: rgb(120, 200, 120);
    -unity-font-style: bold;
    margin-bottom: 6px;
    white-space: normal;
}

.questlog__detail-summary {
    font-size: 13px;
    color: rgb(196, 184, 150);
    margin-bottom: 6px;
    white-space: normal;
}

.questlog__section-header {
    font-size: 14px;
    color: rgb(220, 184, 70);
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 4px;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(78, 62, 34);
}

.questlog__objectives {
    flex-direction: column;
}

.questlog__objective {
    font-size: 13px;
    color: rgb(232, 220, 181);
    margin-bottom: 2px;
    white-space: normal;
}

.questlog__objective--done {
    color: rgb(120, 200, 120);
}

.questlog__rewards {
    flex-direction: column;
}

.questlog__reward {
    font-size: 13px;
    color: rgb(232, 220, 181);
    margin-bottom: 2px;
    white-space: normal;
}

/* ---- Empty state ---- */

.questlog__empty {
    flex-grow: 1;
    font-size: 14px;
    color: rgb(196, 184, 150);
    -unity-text-align: middle-center;
    display: none;
}
