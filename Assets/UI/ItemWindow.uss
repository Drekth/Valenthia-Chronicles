/* Valenthia — Shared item window (loot / inventory) — UI Toolkit */

.ui-window-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* ---- Window panel ---- */

.ui-window {
    min-width: 276px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 14px;
    background-color: rgb(26, 22, 17);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(108, 88, 50);
    border-right-color: rgb(108, 88, 50);
    border-top-color: rgb(126, 104, 60);
    border-bottom-color: rgb(78, 62, 34);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.ui-window__title {
    margin-bottom: 10px;
    font-size: 18px;
    color: rgb(220, 184, 70);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* ---- Item grid (4 columns of 56px + 6px horizontal margins = 248px) ---- */

.ui-window__grid {
    width: 248px;
    flex-direction: row;
    flex-wrap: wrap;
    align-self: center;
    margin-bottom: 12px;
}

.item-slot {
    width: 56px;
    height: 56px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 3px;
    margin-bottom: 3px;
    justify-content: flex-end;
    align-items: flex-end;
    background-color: rgb(20, 17, 12);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(70, 57, 33);
    border-right-color: rgb(70, 57, 33);
    border-top-color: rgb(84, 68, 40);
    border-bottom-color: rgb(54, 43, 24);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-slot:hover {
    border-left-color: rgb(201, 162, 39);
    border-right-color: rgb(201, 162, 39);
    border-top-color: rgb(220, 184, 70);
    border-bottom-color: rgb(170, 134, 30);
    background-color: rgb(38, 32, 24);
}

.item-slot__name {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 4px;
    font-size: 9px;
    color: rgb(232, 220, 181);
    -unity-text-align: upper-center;
    white-space: normal;
}

.item-slot__count {
    margin-right: 4px;
    margin-bottom: 2px;
    font-size: 12px;
    color: rgb(232, 220, 181);
    -unity-font-style: bold;
}

/* ---- Footer buttons ---- */

.ui-window__footer {
    flex-direction: row;
    justify-content: flex-end;
}

.ui-window__button {
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    margin-left: 6px;
    background-color: rgb(38, 32, 24);
    color: rgb(232, 220, 181);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(108, 88, 50);
    border-right-color: rgb(108, 88, 50);
    border-top-color: rgb(126, 104, 60);
    border-bottom-color: rgb(78, 62, 34);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ui-window__button:hover {
    background-color: rgb(54, 45, 33);
    border-left-color: rgb(201, 162, 39);
    border-right-color: rgb(201, 162, 39);
    border-top-color: rgb(220, 184, 70);
    border-bottom-color: rgb(170, 134, 30);
}

/* ---- Equipment doll (paper-doll: two columns flanking a portrait) ---- */

.equip-body {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
}

.equip-column {
    flex-direction: column;
}

.equip-cell {
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.equip-cell__label {
    margin-top: 1px;
    font-size: 10px;
    color: rgb(200, 180, 140);
    -unity-text-align: upper-center;
}

.equip-portrait {
    width: 120px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(20, 16, 11);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(58, 47, 28);
    border-right-color: rgb(58, 47, 28);
    border-top-color: rgb(58, 47, 28);
    border-bottom-color: rgb(58, 47, 28);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
}
