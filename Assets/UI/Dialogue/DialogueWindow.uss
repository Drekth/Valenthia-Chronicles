/* Valenthia — Dialogue panel — UI Toolkit. Reuses the .ui-window* chrome from ItemWindow.uss. */

.dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 80px;
}

/* ---- Spoken line ---- */

.dialogue-text {
    font-size: 15px;
    color: rgb(232, 220, 181);
    white-space: normal;
    -unity-text-align: upper-left;
    margin-bottom: 12px;
    min-height: 40px;
}

/* ---- Options / advance buttons (stacked, gossip-style) ---- */

.dialogue-options {
    flex-direction: column;
}

.dialogue-option {
    margin-top: 4px;
    margin-left: 0;
    margin-right: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 7px;
    padding-bottom: 7px;
    font-size: 14px;
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: rgb(38, 32, 24);
    color: rgb(232, 220, 181);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(108, 88, 50);
    border-right-color: rgb(108, 88, 50);
    border-top-color: rgb(126, 104, 60);
    border-bottom-color: rgb(78, 62, 34);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.dialogue-option:hover {
    background-color: rgb(54, 45, 33);
    border-left-color: rgb(201, 162, 39);
    border-right-color: rgb(201, 162, 39);
    border-top-color: rgb(220, 184, 70);
    border-bottom-color: rgb(170, 134, 30);
}
